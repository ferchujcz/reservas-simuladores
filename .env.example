# ============================================================
# Configuración de entorno — Reservas Gaming
# Copiar como .env y completar con valores reales (NO versionar .env)
# ============================================================

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Puerto del servidor HTTP
PORT=3000

# Zona horaria del establecimiento (IANA timezone)
DB_TIMEZONE=America/Argentina/Buenos_Aires

# Motor de base de datos: postgres (producción) | pglite (PostgreSQL 16 embebido local sin instalación)
DB_ENGINE=postgres

# Conexión a PostgreSQL 16+ (opción 1: URL completa)
DATABASE_URL=postgresql://usuario:password_seguro@localhost:5432/reservas_gaming

# Conexión a PostgreSQL 16+ (opción 2: variables individuales)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reservas_gaming
DB_USER=usuario
DB_PASSWORD=password_seguro

# Secreto para firma HMAC-SHA256 de cookies de sesión y CSRF (mínimo 32 caracteres aleatorios)
COOKIE_SECRET=reemplazar_con_cadena_aleatoria_de_al_menos_32_bytes

# Tiempo de vida de la sesión administrativa en segundos (por defecto 3600 = 1 hora)
SESSION_TTL_SECONDS=3600

# Costo de hash bcrypt (recomendado: 12 en producción)
BCRYPT_SALT_ROUNDS=12

# Opcional: límite de tiempo para solicitudes pendientes antes de expirar (segundos, 0 = expira al terminar el turno)
REQUEST_EXPIRY_SECONDS=1800

# Opcional: protección contra fuerza bruta en login
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=900000
